{
  "name": "worldbuilding-backend",
  "version": "1.0.0",
  "description": "Minimal login and registration backend for the AI-Assisted Collaborative Worldbuilding Platform",
  "main": "server.js",
  "scripts": {
    "check:credentials": "node scripts/check-credentials.js",
    "test:credentials": "node --test test/ai-config.test.js",
    "test:assistant": "node --test test/assistant.test.js test/assistant-http.test.js test/assistant-references.test.js test/gemini.test.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js"
  },
  "private": true,
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "mysql2": "^3.14.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
